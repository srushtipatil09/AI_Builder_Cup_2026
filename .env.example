# Names only. Do not put secrets in this file or in any VITE_ variable.

GOOGLE_CLOUD_PROJECT=
CLOUD_REGION=us-central1
LIVE_LOCATION=us-central1
EXTRACT_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio
EXTRACT_MODEL=gemini-2.5-flash
INSIGHT_MODEL=gemini-2.5-flash
EMBED_MODEL=text-multilingual-embedding-002
FIREBASE_PROJECT_ID=
API_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
WORKER_URL=
TASK_QUEUE=saathi-pipeline
TASK_INVOKER_EMAIL=
BIGQUERY_DATASET=saathi
BIGQUERY_LOCATION=US
DEMO_ENABLED=true
MAX_DAILY_LIVE_MINUTES=120
MAX_DAILY_EXTRACT_CALLS=500
BIGQUERY_MAX_BYTES_BILLED=104857600

# Strict household access: every signup has a Firebase identity. Private bucket for photos and documents.
REQUIRE_HOUSEHOLD_AUTH=true
UPLOADS_BUCKET=
LINK_SIGNING_SECRET=

# Firebase web config. These identify the project to the browser; they are not secrets.
# Never put a server secret in a VITE_ variable: Vite copies every one into the public bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Cloud Run API origin for a hosted build. Empty uses the same origin (the Vite dev proxy).
VITE_API_URL=
